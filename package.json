{
  "name": "mutiny",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "demo:verify-code": "node scripts/verify-demo-code.mjs",
    "demo:record": "pnpm wasm:build && pnpm contract:build && node scripts/record-economy.mjs",
    "dev": "pnpm --filter @mutiny/app dev",
    "build": "pnpm wasm:build && pnpm --filter @mutiny/app build && node scripts/build-offline.mjs",
    "lint": "pnpm --filter @mutiny/app lint",
    "test": "pnpm --filter @mutiny/app test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "wasm:build": "bash scripts/build-wasm.sh",
    "predev": "pnpm wasm:build",
    "test:parity": "node scripts/check-parity.mjs",
    "test:sandbox": "node scripts/sandbox-smoke.mjs",
    "contract:build": "cargo build --locked -p worker --target wasm32-unknown-unknown --release && cargo build --locked -p registry --target wasm32-unknown-unknown --release",
    "test:market": "node scripts/sandbox-market.mjs",
    "test:company": "node scripts/sandbox-company.mjs && node scripts/sandbox-company.mjs --owned",
    "test:paid": "node scripts/sandbox-paid.mjs && node scripts/sandbox-paid.mjs --recovery",
    "test:kingdom": "node scripts/check-kingdom.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.0.0",
    "near-workspaces": "^5.0.0",
    "prettier": "^3.8.2"
  }
}
